// VerilogA for a-GIZO TFT ANN static model (MLP: 4 inputs -> 22 tanh
// hidden neurons -> linear output), trained on ID = f(VG, VD, W, L).
//
// Architecture follows Eq. (1)-(2) of Bahubalindruni et al., "a-GIZO TFT
// neural modeling, circuit simulation and validation", Solid-State
// Electronics 105 (2015) 30-36:
//     yh = tanh(x . wh + bh)      hidden layer
//     y  = yh . wo + bo           output layer (LINEAR, no activation)
//
// Regression target is log10(|ID|), standardized to zero mean / unit
// variance during training; this module reverses both transforms to
// recover ID in amperes. Inputs are min-max scaled to [0,1] using the
// exact training bounds baked in below (see outputs/weights.json).
//
// Auto-generated by scripts/export_verilog_a.py from outputs/weights.json.
// Do not hand-edit the weight/bias tables -- regenerate instead.

`include "constants.h"
`include "disciplines.h"

module tft_ann_static(D, G, S);
inout G, D, S;
electrical D, G, S;

parameter integer NI = 4;      // no. of inputs: VG, VD, W, L
parameter integer NNHL = 22;    // no. of neurons in hidden layer
parameter integer NO = 1;       // no. of outputs (ID)

// device geometry (SI units, matching Spectre convention)
parameter real w = 40e-6 from [5e-6:160e-6];  // channel width, training range [5,160] um
parameter real l = 10e-6 from [5e-6:20e-6];  // channel length, training range [5,20] um

// hidden layer
real hlayer_w[0:(NI*NNHL)-1];
real hlayer_b[0:NNHL-1];
real hlayer_y[0:NNHL-1];
real hlayer_v[0:NNHL-1];

// output layer (linear)
real olayer_w[0:(NO*NNHL)-1];
real olayer_b[0:NO-1];
real olayer_v[0:NO-1];

real vg_s, vd_s, width_s, length_s;   // inputs scaled to [0,1]
real log_id, id;
real gm, gds, temp, temp1;
integer i, ii, jj;

// input scaling (min-max, [0,1]) -- must match src/dataset.py exactly
real vg_lo, vg_hi, vd_lo, vd_hi, w_lo, w_hi, l_lo, l_hi;

// output de-standardization: log10(|ID|) = raw_output*y_std + y_mean
real y_mean, y_std;

analog begin
	@(initial_step or initial_step("static")) begin

	vg_lo = -5.000000; vg_hi = 5.000000;
	vd_lo = 0.000000; vd_hi = 5.000000;
	w_lo  = 5.0e-6; w_hi  = 160.0e-6;
	l_lo  = 5.0e-6; l_hi  = 20.0e-6;

	y_mean = -8.544936;
	y_std  = 3.183718;

	// hidden layer weights: hlayer_w[NI*i + k], k in {0:VG, 1:VD, 2:W, 3:L}
	hlayer_w[0] = 0.314600; 	 hlayer_w[1] = -0.367811; 	 hlayer_w[2] = -0.308714; 	 hlayer_w[3] = 0.148317;
	hlayer_w[4] = -3.343529; 	 hlayer_w[5] = -0.073042; 	 hlayer_w[6] = -0.640568; 	 hlayer_w[7] = 0.036496;
	hlayer_w[8] = 2.742998; 	 hlayer_w[9] = -3.826674; 	 hlayer_w[10] = 0.016480; 	 hlayer_w[11] = -0.054112;
	hlayer_w[12] = 1.918805; 	 hlayer_w[13] = 0.052556; 	 hlayer_w[14] = -0.046116; 	 hlayer_w[15] = -0.209549;
	hlayer_w[16] = 0.961023; 	 hlayer_w[17] = -0.180596; 	 hlayer_w[18] = -0.689954; 	 hlayer_w[19] = -0.218497;
	hlayer_w[20] = -1.541590; 	 hlayer_w[21] = 0.258533; 	 hlayer_w[22] = -0.199925; 	 hlayer_w[23] = 0.735881;
	hlayer_w[24] = -3.148825; 	 hlayer_w[25] = 0.027408; 	 hlayer_w[26] = 0.796532; 	 hlayer_w[27] = -1.107531;
	hlayer_w[28] = 1.267411; 	 hlayer_w[29] = -42.720978; 	 hlayer_w[30] = 0.093078; 	 hlayer_w[31] = -0.081047;
	hlayer_w[32] = -0.414596; 	 hlayer_w[33] = -1.412558; 	 hlayer_w[34] = 0.055923; 	 hlayer_w[35] = -0.068850;
	hlayer_w[36] = 0.056128; 	 hlayer_w[37] = 0.920070; 	 hlayer_w[38] = 0.142132; 	 hlayer_w[39] = -0.074478;
	hlayer_w[40] = 0.589348; 	 hlayer_w[41] = 0.019772; 	 hlayer_w[42] = -0.007413; 	 hlayer_w[43] = 0.989826;
	hlayer_w[44] = -1.132000; 	 hlayer_w[45] = -0.022167; 	 hlayer_w[46] = 5.093528; 	 hlayer_w[47] = 1.035993;
	hlayer_w[48] = 0.947825; 	 hlayer_w[49] = -0.089913; 	 hlayer_w[50] = -3.501978; 	 hlayer_w[51] = 0.474121;
	hlayer_w[52] = -3.045506; 	 hlayer_w[53] = 3.064510; 	 hlayer_w[54] = -0.027500; 	 hlayer_w[55] = 0.043454;
	hlayer_w[56] = 3.789937; 	 hlayer_w[57] = -0.050024; 	 hlayer_w[58] = -0.322348; 	 hlayer_w[59] = -1.605639;
	hlayer_w[60] = 0.365186; 	 hlayer_w[61] = -0.351539; 	 hlayer_w[62] = 0.013346; 	 hlayer_w[63] = -0.522301;
	hlayer_w[64] = 1.250830; 	 hlayer_w[65] = 0.808765; 	 hlayer_w[66] = 0.211392; 	 hlayer_w[67] = 0.222611;
	hlayer_w[68] = -0.618605; 	 hlayer_w[69] = -0.308122; 	 hlayer_w[70] = 0.887271; 	 hlayer_w[71] = -0.051427;
	hlayer_w[72] = 8.193012; 	 hlayer_w[73] = -0.032112; 	 hlayer_w[74] = 0.145088; 	 hlayer_w[75] = -0.397050;
	hlayer_w[76] = -2.785993; 	 hlayer_w[77] = 1.102142; 	 hlayer_w[78] = 0.009944; 	 hlayer_w[79] = 0.233863;
	hlayer_w[80] = -0.246279; 	 hlayer_w[81] = 0.008444; 	 hlayer_w[82] = 2.729550; 	 hlayer_w[83] = -2.074723;
	hlayer_w[84] = 2.000005; 	 hlayer_w[85] = 0.505464; 	 hlayer_w[86] = 0.335484; 	 hlayer_w[87] = 0.039267;

	// hidden layer bias
	hlayer_b[0] = -1.532517;
	hlayer_b[1] = 1.524773;
	hlayer_b[2] = -0.771915;
	hlayer_b[3] = -0.430365;
	hlayer_b[4] = 0.047805;
	hlayer_b[5] = 0.727238;
	hlayer_b[6] = 1.216132;
	hlayer_b[7] = -1.209672;
	hlayer_b[8] = 0.827866;
	hlayer_b[9] = -0.504971;
	hlayer_b[10] = -0.983842;
	hlayer_b[11] = -0.686122;
	hlayer_b[12] = -0.690551;
	hlayer_b[13] = 1.578379;
	hlayer_b[14] = -0.499313;
	hlayer_b[15] = -0.688657;
	hlayer_b[16] = -0.236704;
	hlayer_b[17] = -0.380128;
	hlayer_b[18] = -4.011422;
	hlayer_b[19] = 1.107278;
	hlayer_b[20] = -1.099685;
	hlayer_b[21] = -1.294157;

	// output layer weights
	olayer_w[0] = 0.998564;
	olayer_w[1] = 1.212664;
	olayer_w[2] = 0.340667;
	olayer_w[3] = 0.872206;
	olayer_w[4] = 0.170605;
	olayer_w[5] = -0.723535;
	olayer_w[6] = 0.565487;
	olayer_w[7] = -1.037629;
	olayer_w[8] = 0.402779;
	olayer_w[9] = -0.293039;
	olayer_w[10] = 0.877388;
	olayer_w[11] = -0.253931;
	olayer_w[12] = -0.554767;
	olayer_w[13] = 0.645616;
	olayer_w[14] = -0.633514;
	olayer_w[15] = 0.288958;
	olayer_w[16] = 0.732504;
	olayer_w[17] = -0.756704;
	olayer_w[18] = 1.500616;
	olayer_w[19] = 0.343660;
	olayer_w[20] = 0.368164;
	olayer_w[21] = 0.819103;

	// output layer bias
	olayer_b[0] = -0.481531;

	end // end of initialization

	// preprocessing: scale inputs to [0,1] using training bounds, clamped
	// to the training range to avoid extrapolation blow-up outside it
	vg_s = (V(G,S) - vg_lo) / (vg_hi - vg_lo);
	if (vg_s < 0) vg_s = 0;
	if (vg_s > 1) vg_s = 1;

	vd_s = (V(D,S) - vd_lo) / (vd_hi - vd_lo);
	if (vd_s < 0) vd_s = 0;
	if (vd_s > 1) vd_s = 1;

	width_s = (w - w_lo) / (w_hi - w_lo);
	if (width_s < 0) width_s = 0;
	if (width_s > 1) width_s = 1;

	length_s = (l - l_lo) / (l_hi - l_lo);
	if (length_s < 0) length_s = 0;
	if (length_s > 1) length_s = 1;

	temp  = 0;   // accumulates d(raw_output)/d(vg_s) for gm
	temp1 = 0;   // accumulates d(raw_output)/d(vd_s) for gds

	for (i = 0; i < NNHL; i = i + 1) begin
		hlayer_v[i] = vg_s*hlayer_w[NI*i]   + vd_s*hlayer_w[NI*i+1]
		            + width_s*hlayer_w[NI*i+2] + length_s*hlayer_w[NI*i+3]
		            + hlayer_b[i];
		hlayer_y[i] = tanh(hlayer_v[i]);
		temp  = temp  + olayer_w[i]*hlayer_w[NI*i]   * (1 - hlayer_y[i]*hlayer_y[i]);
		temp1 = temp1 + olayer_w[i]*hlayer_w[NI*i+1] * (1 - hlayer_y[i]*hlayer_y[i]);
	end

	for (ii = 0; ii < NO; ii = ii + 1) begin
		olayer_v[ii] = 0;
		for (jj = 0; jj < NNHL; jj = jj + 1) begin
			olayer_v[ii] = olayer_v[ii] + hlayer_y[jj]*olayer_w[jj];
		end
		olayer_v[ii] = olayer_v[ii] + olayer_b[ii];   // linear output, no tanh
	end

	// post-processing: undo target standardization and the log10 transform
	log_id = olayer_v[0]*y_std + y_mean;
	id = pow(10.0, log_id);

	// small-signal parameters (chain rule through tanh hidden layer, the
	// linear output layer, the log10 back-transform, and the [0,1] input
	// scaling -- d(vg_s)/d(VG) = 1/(vg_hi-vg_lo), same for vd_s)
	gm  = id * `M_LN10 * y_std * temp  / (vg_hi - vg_lo);
	gds = id * `M_LN10 * y_std * temp1 / (vd_hi - vd_lo);

	I(D,S) <+ id;
	I(G,S) <+ 0;
	I(G,D) <+ 0;

	end

endmodule
