// VerilogA for a-GIZO TFT ANN static model (MLP: 4 inputs -> 22 tanh
// hidden neurons -> linear output), trained on ID = f(VG, VD, W, L).
//
// Architecture follows Eq. (1)-(2) of Bahubalindruni et al., "a-GIZO TFT
// neural modeling, circuit simulation and validation", Solid-State
// Electronics 105 (2015) 30-36:
//     yh = tanh(x . wh + bh)      hidden layer
//     y  = yh . wo + bo           output layer (LINEAR, no activation)
//
// Regression target is log10(|ID|), standardized to zero mean / unit
// variance during training; this module reverses both transforms to
// recover ID in amperes. Inputs are min-max scaled to [0,1] using the
// exact training bounds baked in below (see outputs/weights.json).
//
// Auto-generated by scripts/export_verilog_a.py from outputs/weights.json.
// Do not hand-edit the weight/bias tables -- regenerate instead.

`include "constants.h"
`include "disciplines.h"

module tft_ann_static(D, G, S);
inout G, D, S;
electrical D, G, S;

parameter integer NI = 4;      // no. of inputs: VG, VD, W, L
parameter integer NNHL = 22;    // no. of neurons in hidden layer
parameter integer NO = 1;       // no. of outputs (ID)

// device geometry (SI units, matching Spectre convention)
parameter real w = 40e-6 from [5e-6:160e-6];  // channel width, training range [5,160] um
parameter real l = 10e-6 from [5e-6:20e-6];  // channel length, training range [5,20] um

// hidden layer
real hlayer_w[0:(NI*NNHL)-1];
real hlayer_b[0:NNHL-1];
real hlayer_y[0:NNHL-1];
real hlayer_v[0:NNHL-1];

// output layer (linear)
real olayer_w[0:(NO*NNHL)-1];
real olayer_b[0:NO-1];
real olayer_v[0:NO-1];

real vg_s, vd_s, width_s, length_s;   // inputs scaled to [0,1]
real log_id, id;
real gm, gds, temp, temp1;
integer i, ii, jj;

// input scaling (min-max, [0,1]) -- must match src/dataset.py exactly
real vg_lo, vg_hi, vd_lo, vd_hi, w_lo, w_hi, l_lo, l_hi;

// output de-standardization: log10(|ID|) = raw_output*y_std + y_mean
real y_mean, y_std;

analog begin
	@(initial_step or initial_step("static")) begin

	vg_lo = -5.000000; vg_hi = 5.000000;
	vd_lo = 0.000000; vd_hi = 5.000000;
	w_lo  = 5.0e-6; w_hi  = 160.0e-6;
	l_lo  = 5.0e-6; l_hi  = 20.0e-6;

	y_mean = -8.942054;
	y_std  = 3.061316;

	// hidden layer weights: hlayer_w[NI*i + k], k in {0:VG, 1:VD, 2:W, 3:L}
	hlayer_w[0] = 1.087603; 	 hlayer_w[1] = 0.485320; 	 hlayer_w[2] = 0.542599; 	 hlayer_w[3] = -0.558151;
	hlayer_w[4] = -5.634872; 	 hlayer_w[5] = 0.083915; 	 hlayer_w[6] = -0.695717; 	 hlayer_w[7] = -0.304182;
	hlayer_w[8] = 1.950613; 	 hlayer_w[9] = -0.282272; 	 hlayer_w[10] = 3.423896; 	 hlayer_w[11] = 1.437736;
	hlayer_w[12] = 0.599593; 	 hlayer_w[13] = 0.089242; 	 hlayer_w[14] = 0.290542; 	 hlayer_w[15] = 0.044267;
	hlayer_w[16] = -0.265327; 	 hlayer_w[17] = -0.031608; 	 hlayer_w[18] = -0.023840; 	 hlayer_w[19] = -0.012791;
	hlayer_w[20] = -1.800479; 	 hlayer_w[21] = -0.262223; 	 hlayer_w[22] = -0.375453; 	 hlayer_w[23] = -0.595060;
	hlayer_w[24] = -1.046164; 	 hlayer_w[25] = 0.078062; 	 hlayer_w[26] = 0.878737; 	 hlayer_w[27] = 0.358572;
	hlayer_w[28] = 1.674524; 	 hlayer_w[29] = -15.095959; 	 hlayer_w[30] = 0.091879; 	 hlayer_w[31] = 0.136181;
	hlayer_w[32] = -0.391039; 	 hlayer_w[33] = -0.382834; 	 hlayer_w[34] = -1.131018; 	 hlayer_w[35] = 2.611127;
	hlayer_w[36] = 0.384266; 	 hlayer_w[37] = 0.645976; 	 hlayer_w[38] = 0.358756; 	 hlayer_w[39] = 0.044972;
	hlayer_w[40] = 1.138111; 	 hlayer_w[41] = -0.041626; 	 hlayer_w[42] = 1.242720; 	 hlayer_w[43] = 0.566567;
	hlayer_w[44] = 2.165808; 	 hlayer_w[45] = -0.124144; 	 hlayer_w[46] = -0.673345; 	 hlayer_w[47] = 0.318615;
	hlayer_w[48] = 2.646404; 	 hlayer_w[49] = -0.085566; 	 hlayer_w[50] = -9.825466; 	 hlayer_w[51] = -1.624665;
	hlayer_w[52] = -0.821381; 	 hlayer_w[53] = 0.393251; 	 hlayer_w[54] = 0.884190; 	 hlayer_w[55] = 0.825663;
	hlayer_w[56] = 0.612389; 	 hlayer_w[57] = 0.013136; 	 hlayer_w[58] = 0.533258; 	 hlayer_w[59] = 0.059543;
	hlayer_w[60] = 1.375923; 	 hlayer_w[61] = -0.110368; 	 hlayer_w[62] = 0.069137; 	 hlayer_w[63] = 0.317789;
	hlayer_w[64] = -0.163392; 	 hlayer_w[65] = -0.091740; 	 hlayer_w[66] = 0.266189; 	 hlayer_w[67] = -0.399694;
	hlayer_w[68] = 0.016254; 	 hlayer_w[69] = -0.301590; 	 hlayer_w[70] = 1.769091; 	 hlayer_w[71] = 0.919852;
	hlayer_w[72] = 4.391376; 	 hlayer_w[73] = -0.154154; 	 hlayer_w[74] = -0.757057; 	 hlayer_w[75] = 0.020854;
	hlayer_w[76] = -0.768370; 	 hlayer_w[77] = 0.199353; 	 hlayer_w[78] = 0.553877; 	 hlayer_w[79] = 0.381874;
	hlayer_w[80] = 0.163309; 	 hlayer_w[81] = -0.121389; 	 hlayer_w[82] = 0.145424; 	 hlayer_w[83] = -0.305959;
	hlayer_w[84] = 3.886497; 	 hlayer_w[85] = -0.129885; 	 hlayer_w[86] = 1.140383; 	 hlayer_w[87] = 0.328899;

	// hidden layer bias
	hlayer_b[0] = -0.827128;
	hlayer_b[1] = 2.512172;
	hlayer_b[2] = -1.553330;
	hlayer_b[3] = -0.057394;
	hlayer_b[4] = 0.184974;
	hlayer_b[5] = 1.308486;
	hlayer_b[6] = 0.185430;
	hlayer_b[7] = -1.931664;
	hlayer_b[8] = 0.230511;
	hlayer_b[9] = 0.103925;
	hlayer_b[10] = -1.234337;
	hlayer_b[11] = -1.113191;
	hlayer_b[12] = -1.106362;
	hlayer_b[13] = 0.814851;
	hlayer_b[14] = -0.127234;
	hlayer_b[15] = -0.848772;
	hlayer_b[16] = -0.093406;
	hlayer_b[17] = 0.012006;
	hlayer_b[18] = -1.610530;
	hlayer_b[19] = -0.004267;
	hlayer_b[20] = -0.529349;
	hlayer_b[21] = -2.498317;

	// output layer weights
	olayer_w[0] = 0.327424;
	olayer_w[1] = 2.308875;
	olayer_w[2] = 0.564746;
	olayer_w[3] = -0.414803;
	olayer_w[4] = 0.000294;
	olayer_w[5] = -0.745721;
	olayer_w[6] = 0.716887;
	olayer_w[7] = -1.011188;
	olayer_w[8] = 0.175519;
	olayer_w[9] = -0.517817;
	olayer_w[10] = -0.877510;
	olayer_w[11] = -0.780262;
	olayer_w[12] = -0.479224;
	olayer_w[13] = -0.298617;
	olayer_w[14] = -0.293794;
	olayer_w[15] = -0.471816;
	olayer_w[16] = 0.204817;
	olayer_w[17] = -0.764230;
	olayer_w[18] = 1.917066;
	olayer_w[19] = 0.023377;
	olayer_w[20] = 0.123937;
	olayer_w[21] = 2.668941;

	// output layer bias
	olayer_b[0] = -0.268452;

	end // end of initialization

	// preprocessing: scale inputs to [0,1] using training bounds, clamped
	// to the training range to avoid extrapolation blow-up outside it
	vg_s = (V(G,S) - vg_lo) / (vg_hi - vg_lo);
	if (vg_s < 0) vg_s = 0;
	if (vg_s > 1) vg_s = 1;

	vd_s = (V(D,S) - vd_lo) / (vd_hi - vd_lo);
	if (vd_s < 0) vd_s = 0;
	if (vd_s > 1) vd_s = 1;

	width_s = (w - w_lo) / (w_hi - w_lo);
	if (width_s < 0) width_s = 0;
	if (width_s > 1) width_s = 1;

	length_s = (l - l_lo) / (l_hi - l_lo);
	if (length_s < 0) length_s = 0;
	if (length_s > 1) length_s = 1;

	temp  = 0;   // accumulates d(raw_output)/d(vg_s) for gm
	temp1 = 0;   // accumulates d(raw_output)/d(vd_s) for gds

	for (i = 0; i < NNHL; i = i + 1) begin
		hlayer_v[i] = vg_s*hlayer_w[NI*i]   + vd_s*hlayer_w[NI*i+1]
		            + width_s*hlayer_w[NI*i+2] + length_s*hlayer_w[NI*i+3]
		            + hlayer_b[i];
		hlayer_y[i] = tanh(hlayer_v[i]);
		temp  = temp  + olayer_w[i]*hlayer_w[NI*i]   * (1 - hlayer_y[i]*hlayer_y[i]);
		temp1 = temp1 + olayer_w[i]*hlayer_w[NI*i+1] * (1 - hlayer_y[i]*hlayer_y[i]);
	end

	for (ii = 0; ii < NO; ii = ii + 1) begin
		olayer_v[ii] = 0;
		for (jj = 0; jj < NNHL; jj = jj + 1) begin
			olayer_v[ii] = olayer_v[ii] + hlayer_y[jj]*olayer_w[jj];
		end
		olayer_v[ii] = olayer_v[ii] + olayer_b[ii];   // linear output, no tanh
	end

	// post-processing: undo target standardization and the log10 transform
	log_id = olayer_v[0]*y_std + y_mean;
	id = pow(10.0, log_id);

	// small-signal parameters (chain rule through tanh hidden layer, the
	// linear output layer, the log10 back-transform, and the [0,1] input
	// scaling -- d(vg_s)/d(VG) = 1/(vg_hi-vg_lo), same for vd_s)
	gm  = id * `M_LN10 * y_std * temp  / (vg_hi - vg_lo);
	gds = id * `M_LN10 * y_std * temp1 / (vd_hi - vd_lo);

	I(D,S) <+ id;
	I(G,S) <+ 0;
	I(G,D) <+ 0;

	end

endmodule
