// VerilogA for a-GIZO TFT ANN static model (MLP: 4 inputs -> 22 tanh
// hidden neurons -> linear output), trained on ID = f(VG, VD, W, L).
//
// Architecture follows Eq. (1)-(2) of Bahubalindruni et al., "a-GIZO TFT
// neural modeling, circuit simulation and validation", Solid-State
// Electronics 105 (2015) 30-36:
//     yh = tanh(x . wh + bh)      hidden layer
//     y  = yh . wo + bo           output layer (LINEAR, no activation)
//
// Regression target is log10(|ID|), standardized to zero mean / unit
// variance during training; this module reverses both transforms to
// recover ID in amperes. Inputs are min-max scaled to [0,1] using the
// exact training bounds baked in below (see outputs/weights.json).
//
// Auto-generated by scripts/export_verilog_a.py from outputs/weights.json.
// Do not hand-edit the weight/bias tables -- regenerate instead.

`include "constants.h"
`include "disciplines.h"

module tft_ann_static(D, G, S);
inout G, D, S;
electrical D, G, S;

parameter integer NI = 4;      // no. of inputs: VG, VD, W, L
parameter integer NNHL = 22;    // no. of neurons in hidden layer
parameter integer NO = 1;       // no. of outputs (ID)

// device geometry (SI units, matching Spectre convention)
parameter real w = 40e-6 from [5e-6:160e-6];  // channel width, training range [5,160] um
parameter real l = 10e-6 from [5e-6:20e-6];  // channel length, training range [5,20] um

// hidden layer
real hlayer_w[0:(NI*NNHL)-1];
real hlayer_b[0:NNHL-1];
real hlayer_y[0:NNHL-1];
real hlayer_v[0:NNHL-1];

// output layer (linear)
real olayer_w[0:(NO*NNHL)-1];
real olayer_b[0:NO-1];
real olayer_v[0:NO-1];

real vg_s, vd_s, width_s, length_s;   // inputs scaled to [0,1]
real log_id, id;
real gm, gds, temp, temp1;
integer i, ii, jj;

// input scaling (min-max, [0,1]) -- must match src/dataset.py exactly
real vg_lo, vg_hi, vd_lo, vd_hi, w_lo, w_hi, l_lo, l_hi;

// output de-standardization: log10(|ID|) = raw_output*y_std + y_mean
real y_mean, y_std;

analog begin
	@(initial_step or initial_step("static")) begin

	vg_lo = -5.000000; vg_hi = 5.000000;
	vd_lo = 0.000000; vd_hi = 5.000000;
	w_lo  = 5.0e-6; w_hi  = 160.0e-6;
	l_lo  = 5.0e-6; l_hi  = 20.0e-6;

	y_mean = -8.527039;
	y_std  = 3.059162;

	// hidden layer weights: hlayer_w[NI*i + k], k in {0:VG, 1:VD, 2:W, 3:L}
	hlayer_w[0] = 0.666877; 	 hlayer_w[1] = 0.173161; 	 hlayer_w[2] = -0.239692; 	 hlayer_w[3] = 0.000995;
	hlayer_w[4] = -0.761805; 	 hlayer_w[5] = -0.233263; 	 hlayer_w[6] = 0.239400; 	 hlayer_w[7] = 0.022341;
	hlayer_w[8] = 1.818728; 	 hlayer_w[9] = -1.068150; 	 hlayer_w[10] = 0.283505; 	 hlayer_w[11] = -0.006488;
	hlayer_w[12] = 3.446881; 	 hlayer_w[13] = -0.022808; 	 hlayer_w[14] = 0.368186; 	 hlayer_w[15] = -0.035390;
	hlayer_w[16] = -0.438397; 	 hlayer_w[17] = -0.081877; 	 hlayer_w[18] = 0.021155; 	 hlayer_w[19] = 0.074483;
	hlayer_w[20] = -1.701875; 	 hlayer_w[21] = -0.077091; 	 hlayer_w[22] = -1.463723; 	 hlayer_w[23] = 0.290919;
	hlayer_w[24] = -1.675150; 	 hlayer_w[25] = 0.224143; 	 hlayer_w[26] = -0.302997; 	 hlayer_w[27] = 0.673899;
	hlayer_w[28] = 1.971259; 	 hlayer_w[29] = -60.020660; 	 hlayer_w[30] = 0.064005; 	 hlayer_w[31] = -0.035755;
	hlayer_w[32] = -0.308052; 	 hlayer_w[33] = -0.215449; 	 hlayer_w[34] = 0.132256; 	 hlayer_w[35] = 0.819692;
	hlayer_w[36] = -0.589968; 	 hlayer_w[37] = 0.128045; 	 hlayer_w[38] = 0.515893; 	 hlayer_w[39] = -0.243591;
	hlayer_w[40] = 0.995361; 	 hlayer_w[41] = 0.794740; 	 hlayer_w[42] = 0.352809; 	 hlayer_w[43] = 0.160954;
	hlayer_w[44] = 1.561924; 	 hlayer_w[45] = 0.134542; 	 hlayer_w[46] = -0.130782; 	 hlayer_w[47] = 0.067568;
	hlayer_w[48] = 3.203926; 	 hlayer_w[49] = -0.252057; 	 hlayer_w[50] = -8.868464; 	 hlayer_w[51] = -1.501026;
	hlayer_w[52] = -2.719168; 	 hlayer_w[53] = 0.190415; 	 hlayer_w[54] = 0.753699; 	 hlayer_w[55] = 0.367519;
	hlayer_w[56] = 1.278200; 	 hlayer_w[57] = -0.109926; 	 hlayer_w[58] = 0.782177; 	 hlayer_w[59] = -1.619334;
	hlayer_w[60] = 0.793868; 	 hlayer_w[61] = -0.929492; 	 hlayer_w[62] = 1.068659; 	 hlayer_w[63] = 0.669726;
	hlayer_w[64] = 0.471275; 	 hlayer_w[65] = 0.079592; 	 hlayer_w[66] = -0.063669; 	 hlayer_w[67] = 0.013920;
	hlayer_w[68] = -1.459811; 	 hlayer_w[69] = 0.117915; 	 hlayer_w[70] = 0.570364; 	 hlayer_w[71] = 0.961498;
	hlayer_w[72] = 7.285757; 	 hlayer_w[73] = -0.060238; 	 hlayer_w[74] = 0.220042; 	 hlayer_w[75] = -0.164705;
	hlayer_w[76] = -0.984443; 	 hlayer_w[77] = 0.405447; 	 hlayer_w[78] = 0.269192; 	 hlayer_w[79] = 0.041077;
	hlayer_w[80] = 0.063022; 	 hlayer_w[81] = 0.058125; 	 hlayer_w[82] = -0.661961; 	 hlayer_w[83] = 0.662182;
	hlayer_w[84] = 2.516444; 	 hlayer_w[85] = -0.105363; 	 hlayer_w[86] = 0.002437; 	 hlayer_w[87] = -0.683699;

	// hidden layer bias
	hlayer_b[0] = -0.443025;
	hlayer_b[1] = 0.497659;
	hlayer_b[2] = -0.207932;
	hlayer_b[3] = -1.404993;
	hlayer_b[4] = 0.375535;
	hlayer_b[5] = 1.246911;
	hlayer_b[6] = 0.779256;
	hlayer_b[7] = -1.821339;
	hlayer_b[8] = 1.004567;
	hlayer_b[9] = 0.310327;
	hlayer_b[10] = -0.604825;
	hlayer_b[11] = -0.958913;
	hlayer_b[12] = -1.732409;
	hlayer_b[13] = 1.540449;
	hlayer_b[14] = -0.647093;
	hlayer_b[15] = -1.202464;
	hlayer_b[16] = -0.311482;
	hlayer_b[17] = 0.341042;
	hlayer_b[18] = -3.742602;
	hlayer_b[19] = 0.152075;
	hlayer_b[20] = -1.101517;
	hlayer_b[21] = -2.136411;

	// output layer weights
	olayer_w[0] = 0.124865;
	olayer_w[1] = -0.223417;
	olayer_w[2] = 0.508268;
	olayer_w[3] = -1.284939;
	olayer_w[4] = -0.037883;
	olayer_w[5] = -0.678348;
	olayer_w[6] = 0.021477;
	olayer_w[7] = -1.424371;
	olayer_w[8] = -0.558010;
	olayer_w[9] = -0.313832;
	olayer_w[10] = 0.316324;
	olayer_w[11] = 0.015714;
	olayer_w[12] = -0.245194;
	olayer_w[13] = 1.145250;
	olayer_w[14] = -0.417072;
	olayer_w[15] = -0.229490;
	olayer_w[16] = 0.003430;
	olayer_w[17] = -0.521271;
	olayer_w[18] = 1.556926;
	olayer_w[19] = -0.159276;
	olayer_w[20] = 0.505206;
	olayer_w[21] = 0.922670;

	// output layer bias
	olayer_b[0] = -0.658464;

	end // end of initialization

	// preprocessing: scale inputs to [0,1] using training bounds, clamped
	// to the training range to avoid extrapolation blow-up outside it
	vg_s = (V(G,S) - vg_lo) / (vg_hi - vg_lo);
	if (vg_s < 0) vg_s = 0;
	if (vg_s > 1) vg_s = 1;

	vd_s = (V(D,S) - vd_lo) / (vd_hi - vd_lo);
	if (vd_s < 0) vd_s = 0;
	if (vd_s > 1) vd_s = 1;

	width_s = (w - w_lo) / (w_hi - w_lo);
	if (width_s < 0) width_s = 0;
	if (width_s > 1) width_s = 1;

	length_s = (l - l_lo) / (l_hi - l_lo);
	if (length_s < 0) length_s = 0;
	if (length_s > 1) length_s = 1;

	temp  = 0;   // accumulates d(raw_output)/d(vg_s) for gm
	temp1 = 0;   // accumulates d(raw_output)/d(vd_s) for gds

	for (i = 0; i < NNHL; i = i + 1) begin
		hlayer_v[i] = vg_s*hlayer_w[NI*i]   + vd_s*hlayer_w[NI*i+1]
		            + width_s*hlayer_w[NI*i+2] + length_s*hlayer_w[NI*i+3]
		            + hlayer_b[i];
		hlayer_y[i] = tanh(hlayer_v[i]);
		temp  = temp  + olayer_w[i]*hlayer_w[NI*i]   * (1 - hlayer_y[i]*hlayer_y[i]);
		temp1 = temp1 + olayer_w[i]*hlayer_w[NI*i+1] * (1 - hlayer_y[i]*hlayer_y[i]);
	end

	for (ii = 0; ii < NO; ii = ii + 1) begin
		olayer_v[ii] = 0;
		for (jj = 0; jj < NNHL; jj = jj + 1) begin
			olayer_v[ii] = olayer_v[ii] + hlayer_y[jj]*olayer_w[jj];
		end
		olayer_v[ii] = olayer_v[ii] + olayer_b[ii];   // linear output, no tanh
	end

	// post-processing: undo target standardization and the log10 transform
	log_id = olayer_v[0]*y_std + y_mean;
	id = pow(10.0, log_id);

	// small-signal parameters (chain rule through tanh hidden layer, the
	// linear output layer, the log10 back-transform, and the [0,1] input
	// scaling -- d(vg_s)/d(VG) = 1/(vg_hi-vg_lo), same for vd_s)
	gm  = id * `M_LN10 * y_std * temp  / (vg_hi - vg_lo);
	gds = id * `M_LN10 * y_std * temp1 / (vd_hi - vd_lo);

	I(D,S) <+ id;
	I(G,S) <+ 0;
	I(G,D) <+ 0;

	end

endmodule
