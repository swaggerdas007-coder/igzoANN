// VerilogA for a-GIZO TFT ANN static model (MLP: 4 inputs -> 32 tanh
// hidden neurons -> linear output), trained on ID = f(VG, VD, W, L).
//
// Architecture follows Eq. (1)-(2) of Bahubalindruni et al., "a-GIZO TFT
// neural modeling, circuit simulation and validation", Solid-State
// Electronics 105 (2015) 30-36:
//     yh = tanh(x . wh + bh)      hidden layer
//     y  = yh . wo + bo           output layer (LINEAR, no activation)
//
// Regression target is log10(|ID|), standardized to zero mean / unit
// variance during training; this module reverses both transforms to
// recover ID in amperes. Inputs are min-max scaled to [0,1] using the
// exact training bounds baked in below (see outputs/weights.json).
//
// Auto-generated by scripts/export_verilog_a.py from outputs/weights.json.
// Do not hand-edit the weight/bias tables -- regenerate instead.

`include "constants.h"
`include "disciplines.h"

module tft_ann_static(D, G, S);
inout G, D, S;
electrical D, G, S;

parameter integer NI = 4;      // no. of inputs: VG, VD, W, L
parameter integer NNHL = 32;    // no. of neurons in hidden layer
parameter integer NO = 1;       // no. of outputs (ID)

// device geometry (SI units, matching Spectre convention)
parameter real w = 40e-6 from [5e-6:160e-6];  // channel width, training range [5,160] um
parameter real l = 10e-6 from [5e-6:20e-6];  // channel length, training range [5,20] um

// hidden layer
real hlayer_w[0:(NI*NNHL)-1];
real hlayer_b[0:NNHL-1];
real hlayer_y[0:NNHL-1];
real hlayer_v[0:NNHL-1];

// output layer (linear)
real olayer_w[0:(NO*NNHL)-1];
real olayer_b[0:NO-1];
real olayer_v[0:NO-1];

real vg_s, vd_s, width_s, length_s;   // inputs scaled to [0,1]
real log_id, id;
real gm, gds, temp, temp1;
integer i, ii, jj;

// input scaling (min-max, [0,1]) -- must match src/dataset.py exactly
real vg_lo, vg_hi, vd_lo, vd_hi, w_lo, w_hi, l_lo, l_hi;

// output de-standardization: log10(|ID|) = raw_output*y_std + y_mean
real y_mean, y_std;

analog begin
	@(initial_step or initial_step("static")) begin

	vg_lo = -5.000000; vg_hi = 5.000000;
	vd_lo = 0.000000; vd_hi = 5.000000;
	w_lo  = 5.0e-6; w_hi  = 160.0e-6;
	l_lo  = 5.0e-6; l_hi  = 20.0e-6;

	y_mean = -8.942054;
	y_std  = 3.061316;

	// hidden layer weights: hlayer_w[NI*i + k], k in {0:VG, 1:VD, 2:W, 3:L}
	hlayer_w[0] = 0.788857; 	 hlayer_w[1] = 2.209924; 	 hlayer_w[2] = 0.189252; 	 hlayer_w[3] = 0.185657;
	hlayer_w[4] = 2.034468; 	 hlayer_w[5] = 0.006883; 	 hlayer_w[6] = 0.734144; 	 hlayer_w[7] = 1.005106;
	hlayer_w[8] = -1.252980; 	 hlayer_w[9] = -0.003150; 	 hlayer_w[10] = 7.058150; 	 hlayer_w[11] = -1.239817;
	hlayer_w[12] = -0.000734; 	 hlayer_w[13] = 0.000107; 	 hlayer_w[14] = 0.000606; 	 hlayer_w[15] = -0.000435;
	hlayer_w[16] = 3.087128; 	 hlayer_w[17] = 0.810857; 	 hlayer_w[18] = 0.366765; 	 hlayer_w[19] = 0.160909;
	hlayer_w[20] = -3.652180; 	 hlayer_w[21] = 0.046654; 	 hlayer_w[22] = 1.128783; 	 hlayer_w[23] = -0.128095;
	hlayer_w[24] = -0.001928; 	 hlayer_w[25] = -0.000248; 	 hlayer_w[26] = 0.000847; 	 hlayer_w[27] = -0.001432;
	hlayer_w[28] = 0.203540; 	 hlayer_w[29] = -0.789309; 	 hlayer_w[30] = 0.304840; 	 hlayer_w[31] = -0.546581;
	hlayer_w[32] = 8.515797; 	 hlayer_w[33] = -0.155373; 	 hlayer_w[34] = 0.706499; 	 hlayer_w[35] = 0.393668;
	hlayer_w[36] = -0.199831; 	 hlayer_w[37] = 1.309524; 	 hlayer_w[38] = 0.082208; 	 hlayer_w[39] = -0.072819;
	hlayer_w[40] = 0.000070; 	 hlayer_w[41] = 0.000075; 	 hlayer_w[42] = 0.000285; 	 hlayer_w[43] = -0.000267;
	hlayer_w[44] = 2.887900; 	 hlayer_w[45] = 0.085982; 	 hlayer_w[46] = -0.863173; 	 hlayer_w[47] = -0.422194;
	hlayer_w[48] = -0.799702; 	 hlayer_w[49] = -2.033563; 	 hlayer_w[50] = -0.214980; 	 hlayer_w[51] = -0.024196;
	hlayer_w[52] = -0.612445; 	 hlayer_w[53] = 0.028216; 	 hlayer_w[54] = -1.246456; 	 hlayer_w[55] = 4.481590;
	hlayer_w[56] = -1.846316; 	 hlayer_w[57] = 0.593455; 	 hlayer_w[58] = -0.015660; 	 hlayer_w[59] = -0.136422;
	hlayer_w[60] = 1.544701; 	 hlayer_w[61] = -65.254105; 	 hlayer_w[62] = 0.270048; 	 hlayer_w[63] = 0.240661;
	hlayer_w[64] = -0.001414; 	 hlayer_w[65] = -0.000264; 	 hlayer_w[66] = 0.000606; 	 hlayer_w[67] = -0.001722;
	hlayer_w[68] = 0.482852; 	 hlayer_w[69] = 0.021466; 	 hlayer_w[70] = 9.384650; 	 hlayer_w[71] = 1.579896;
	hlayer_w[72] = 0.677561; 	 hlayer_w[73] = 0.018059; 	 hlayer_w[74] = -1.471672; 	 hlayer_w[75] = -2.505232;
	hlayer_w[76] = -0.520533; 	 hlayer_w[77] = -0.054476; 	 hlayer_w[78] = -0.169528; 	 hlayer_w[79] = 1.258902;
	hlayer_w[80] = -3.437316; 	 hlayer_w[81] = -0.282167; 	 hlayer_w[82] = -0.344066; 	 hlayer_w[83] = -0.234239;
	hlayer_w[84] = 2.404216; 	 hlayer_w[85] = -0.133015; 	 hlayer_w[86] = -1.200789; 	 hlayer_w[87] = 0.329707;
	hlayer_w[88] = -4.318386; 	 hlayer_w[89] = 0.016416; 	 hlayer_w[90] = 5.207554; 	 hlayer_w[91] = 0.597892;
	hlayer_w[92] = 0.363460; 	 hlayer_w[93] = 0.347618; 	 hlayer_w[94] = -0.763342; 	 hlayer_w[95] = -0.021024;
	hlayer_w[96] = 0.860451; 	 hlayer_w[97] = -0.022541; 	 hlayer_w[98] = 1.251469; 	 hlayer_w[99] = -1.159296;
	hlayer_w[100] = 0.001602; 	 hlayer_w[101] = -0.000164; 	 hlayer_w[102] = 0.000246; 	 hlayer_w[103] = 0.001881;
	hlayer_w[104] = -0.227771; 	 hlayer_w[105] = 0.005057; 	 hlayer_w[106] = -1.268210; 	 hlayer_w[107] = -0.864729;
	hlayer_w[108] = -1.462312; 	 hlayer_w[109] = 0.004300; 	 hlayer_w[110] = 6.622401; 	 hlayer_w[111] = -0.058476;
	hlayer_w[112] = 1.193326; 	 hlayer_w[113] = -0.009086; 	 hlayer_w[114] = -3.286902; 	 hlayer_w[115] = 1.668240;
	hlayer_w[116] = 3.827969; 	 hlayer_w[117] = -0.044249; 	 hlayer_w[118] = -2.301499; 	 hlayer_w[119] = 0.267389;
	hlayer_w[120] = -0.527665; 	 hlayer_w[121] = 0.267212; 	 hlayer_w[122] = 0.746527; 	 hlayer_w[123] = 0.758779;
	hlayer_w[124] = -0.001703; 	 hlayer_w[125] = -0.000549; 	 hlayer_w[126] = 0.000682; 	 hlayer_w[127] = -0.002664;

	// hidden layer bias
	hlayer_b[0] = 0.913660;
	hlayer_b[1] = -1.586235;
	hlayer_b[2] = 0.095963;
	hlayer_b[3] = 0.000112;
	hlayer_b[4] = -2.503599;
	hlayer_b[5] = 3.024457;
	hlayer_b[6] = 0.001436;
	hlayer_b[7] = -0.325730;
	hlayer_b[8] = -5.288231;
	hlayer_b[9] = -0.148914;
	hlayer_b[10] = -0.000102;
	hlayer_b[11] = -0.041261;
	hlayer_b[12] = 0.699486;
	hlayer_b[13] = -0.384560;
	hlayer_b[14] = 1.851819;
	hlayer_b[15] = -1.290216;
	hlayer_b[16] = 0.001098;
	hlayer_b[17] = -1.563023;
	hlayer_b[18] = -0.539663;
	hlayer_b[19] = 0.491972;
	hlayer_b[20] = 2.142080;
	hlayer_b[21] = -1.920079;
	hlayer_b[22] = 2.684408;
	hlayer_b[23] = 0.028959;
	hlayer_b[24] = -0.606180;
	hlayer_b[25] = -0.001280;
	hlayer_b[26] = 1.044605;
	hlayer_b[27] = -0.024463;
	hlayer_b[28] = -0.722012;
	hlayer_b[29] = -2.219025;
	hlayer_b[30] = 0.897722;
	hlayer_b[31] = 0.001694;

	// output layer weights
	olayer_w[0] = 0.191463;
	olayer_w[1] = 0.702611;
	olayer_w[2] = 1.043523;
	olayer_w[3] = -0.000015;
	olayer_w[4] = 0.970621;
	olayer_w[5] = -1.135900;
	olayer_w[6] = 0.000069;
	olayer_w[7] = 0.131407;
	olayer_w[8] = 1.545210;
	olayer_w[9] = -0.312631;
	olayer_w[10] = -0.000048;
	olayer_w[11] = -0.408185;
	olayer_w[12] = -0.190738;
	olayer_w[13] = 0.315844;
	olayer_w[14] = 0.518516;
	olayer_w[15] = -0.648074;
	olayer_w[16] = -0.000007;
	olayer_w[17] = 0.490034;
	olayer_w[18] = 0.483614;
	olayer_w[19] = -0.283802;
	olayer_w[20] = 1.634995;
	olayer_w[21] = 0.950316;
	olayer_w[22] = 1.240070;
	olayer_w[23] = 0.180198;
	olayer_w[24] = 0.631098;
	olayer_w[25] = 0.000020;
	olayer_w[26] = 0.729317;
	olayer_w[27] = -1.571019;
	olayer_w[28] = 0.581792;
	olayer_w[29] = -1.442203;
	olayer_w[30] = -0.180898;
	olayer_w[31] = -0.000015;

	// output layer bias
	olayer_b[0] = 0.000051;

	end // end of initialization

	// preprocessing: scale inputs to [0,1] using training bounds, clamped
	// to the training range to avoid extrapolation blow-up outside it
	vg_s = (V(G,S) - vg_lo) / (vg_hi - vg_lo);
	if (vg_s < 0) vg_s = 0;
	if (vg_s > 1) vg_s = 1;

	vd_s = (V(D,S) - vd_lo) / (vd_hi - vd_lo);
	if (vd_s < 0) vd_s = 0;
	if (vd_s > 1) vd_s = 1;

	width_s = (w - w_lo) / (w_hi - w_lo);
	if (width_s < 0) width_s = 0;
	if (width_s > 1) width_s = 1;

	length_s = (l - l_lo) / (l_hi - l_lo);
	if (length_s < 0) length_s = 0;
	if (length_s > 1) length_s = 1;

	temp  = 0;   // accumulates d(raw_output)/d(vg_s) for gm
	temp1 = 0;   // accumulates d(raw_output)/d(vd_s) for gds

	for (i = 0; i < NNHL; i = i + 1) begin
		hlayer_v[i] = vg_s*hlayer_w[NI*i]   + vd_s*hlayer_w[NI*i+1]
		            + width_s*hlayer_w[NI*i+2] + length_s*hlayer_w[NI*i+3]
		            + hlayer_b[i];
		hlayer_y[i] = tanh(hlayer_v[i]);
		temp  = temp  + olayer_w[i]*hlayer_w[NI*i]   * (1 - hlayer_y[i]*hlayer_y[i]);
		temp1 = temp1 + olayer_w[i]*hlayer_w[NI*i+1] * (1 - hlayer_y[i]*hlayer_y[i]);
	end

	for (ii = 0; ii < NO; ii = ii + 1) begin
		olayer_v[ii] = 0;
		for (jj = 0; jj < NNHL; jj = jj + 1) begin
			olayer_v[ii] = olayer_v[ii] + hlayer_y[jj]*olayer_w[jj];
		end
		olayer_v[ii] = olayer_v[ii] + olayer_b[ii];   // linear output, no tanh
	end

	// post-processing: undo target standardization and the log10 transform
	log_id = olayer_v[0]*y_std + y_mean;
	id = pow(10.0, log_id);

	// small-signal parameters (chain rule through tanh hidden layer, the
	// linear output layer, the log10 back-transform, and the [0,1] input
	// scaling -- d(vg_s)/d(VG) = 1/(vg_hi-vg_lo), same for vd_s)
	gm  = id * `M_LN10 * y_std * temp  / (vg_hi - vg_lo);
	gds = id * `M_LN10 * y_std * temp1 / (vd_hi - vd_lo);

	I(D,S) <+ id;
	I(G,S) <+ 0;
	I(G,D) <+ 0;

	end

endmodule
