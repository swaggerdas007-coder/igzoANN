// VerilogA for a-GIZO TFT ANN static model (MLP: 4 inputs -> 22 tanh
// hidden neurons -> linear output), trained on ID = f(VG, VD, W, L).
//
// Architecture follows Eq. (1)-(2) of Bahubalindruni et al., "a-GIZO TFT
// neural modeling, circuit simulation and validation", Solid-State
// Electronics 105 (2015) 30-36:
//     yh = tanh(x . wh + bh)      hidden layer
//     y  = yh . wo + bo           output layer (LINEAR, no activation)
//
// Regression target is log10(|ID|), standardized to zero mean / unit
// variance during training; this module reverses both transforms to
// recover ID in amperes. Inputs are min-max scaled to [0,1] using the
// exact training bounds baked in below (see outputs/weights.json).
//
// Auto-generated by scripts/export_verilog_a.py from outputs/weights.json.
// Do not hand-edit the weight/bias tables -- regenerate instead.

`include "constants.h"
`include "disciplines.h"

module tft_ann_static(D, G, S);
inout G, D, S;
electrical D, G, S;

parameter integer NI = 4;      // no. of inputs: VG, VD, W, L
parameter integer NNHL = 22;    // no. of neurons in hidden layer
parameter integer NO = 1;       // no. of outputs (ID)

// device geometry (SI units, matching Spectre convention)
parameter real w = 40e-6 from [5e-6:160e-6];  // channel width, training range [5,160] um
parameter real l = 10e-6 from [5e-6:20e-6];  // channel length, training range [5,20] um

// hidden layer
real hlayer_w[0:(NI*NNHL)-1];
real hlayer_b[0:NNHL-1];
real hlayer_y[0:NNHL-1];
real hlayer_v[0:NNHL-1];

// output layer (linear)
real olayer_w[0:(NO*NNHL)-1];
real olayer_b[0:NO-1];
real olayer_v[0:NO-1];

real vg_s, vd_s, width_s, length_s;   // inputs scaled to [0,1]
real log_id, id;
real gm, gds, temp, temp1;
integer i, ii, jj;

// input scaling (min-max, [0,1]) -- must match src/dataset.py exactly
real vg_lo, vg_hi, vd_lo, vd_hi, w_lo, w_hi, l_lo, l_hi;

// output de-standardization: log10(|ID|) = raw_output*y_std + y_mean
real y_mean, y_std;

analog begin
	@(initial_step or initial_step("static")) begin

	vg_lo = -5.000000; vg_hi = 5.000000;
	vd_lo = 0.000000; vd_hi = 5.000000;
	w_lo  = 5.0e-6; w_hi  = 160.0e-6;
	l_lo  = 5.0e-6; l_hi  = 20.0e-6;

	y_mean = -8.544936;
	y_std  = 3.183718;

	// hidden layer weights: hlayer_w[NI*i + k], k in {0:VG, 1:VD, 2:W, 3:L}
	hlayer_w[0] = 0.319162; 	 hlayer_w[1] = -0.196628; 	 hlayer_w[2] = 0.629670; 	 hlayer_w[3] = -1.021747;
	hlayer_w[4] = -4.007212; 	 hlayer_w[5] = -0.054894; 	 hlayer_w[6] = -0.541538; 	 hlayer_w[7] = 0.695768;
	hlayer_w[8] = 2.132239; 	 hlayer_w[9] = -3.047981; 	 hlayer_w[10] = -0.056296; 	 hlayer_w[11] = 0.030515;
	hlayer_w[12] = 2.151557; 	 hlayer_w[13] = -0.144926; 	 hlayer_w[14] = -0.190973; 	 hlayer_w[15] = -0.243429;
	hlayer_w[16] = 0.613082; 	 hlayer_w[17] = -0.767789; 	 hlayer_w[18] = -1.561481; 	 hlayer_w[19] = 0.648749;
	hlayer_w[20] = -2.322120; 	 hlayer_w[21] = 0.365796; 	 hlayer_w[22] = -0.043099; 	 hlayer_w[23] = 0.961276;
	hlayer_w[24] = -3.526138; 	 hlayer_w[25] = 0.012572; 	 hlayer_w[26] = 0.417158; 	 hlayer_w[27] = -1.149920;
	hlayer_w[28] = -1.053707; 	 hlayer_w[29] = -1.952453; 	 hlayer_w[30] = 0.109374; 	 hlayer_w[31] = -0.107172;
	hlayer_w[32] = 0.000075; 	 hlayer_w[33] = -0.004260; 	 hlayer_w[34] = 0.002926; 	 hlayer_w[35] = -0.004654;
	hlayer_w[36] = -0.049413; 	 hlayer_w[37] = 1.251865; 	 hlayer_w[38] = -0.104765; 	 hlayer_w[39] = -0.011398;
	hlayer_w[40] = 0.760995; 	 hlayer_w[41] = -0.038729; 	 hlayer_w[42] = 0.928174; 	 hlayer_w[43] = 0.671930;
	hlayer_w[44] = -0.721016; 	 hlayer_w[45] = 0.024959; 	 hlayer_w[46] = 4.465836; 	 hlayer_w[47] = 2.381080;
	hlayer_w[48] = 1.497003; 	 hlayer_w[49] = -57.214943; 	 hlayer_w[50] = 0.102853; 	 hlayer_w[51] = -0.084614;
	hlayer_w[52] = -2.886141; 	 hlayer_w[53] = 2.697611; 	 hlayer_w[54] = 0.034763; 	 hlayer_w[55] = -0.031840;
	hlayer_w[56] = 3.449210; 	 hlayer_w[57] = -0.093935; 	 hlayer_w[58] = -1.315376; 	 hlayer_w[59] = -1.707860;
	hlayer_w[60] = 0.292022; 	 hlayer_w[61] = -0.528172; 	 hlayer_w[62] = 0.348837; 	 hlayer_w[63] = -0.082171;
	hlayer_w[64] = 0.550871; 	 hlayer_w[65] = 0.253284; 	 hlayer_w[66] = 1.009332; 	 hlayer_w[67] = 0.556522;
	hlayer_w[68] = -0.680651; 	 hlayer_w[69] = -0.196215; 	 hlayer_w[70] = 1.505283; 	 hlayer_w[71] = 0.042079;
	hlayer_w[72] = 8.355433; 	 hlayer_w[73] = -0.044837; 	 hlayer_w[74] = 0.208452; 	 hlayer_w[75] = -0.399424;
	hlayer_w[76] = -2.930775; 	 hlayer_w[77] = 1.003118; 	 hlayer_w[78] = 0.102330; 	 hlayer_w[79] = 0.290766;
	hlayer_w[80] = 0.856479; 	 hlayer_w[81] = -0.050034; 	 hlayer_w[82] = 3.012480; 	 hlayer_w[83] = -3.253463;
	hlayer_w[84] = 2.616966; 	 hlayer_w[85] = 0.612235; 	 hlayer_w[86] = 0.130832; 	 hlayer_w[87] = -0.196004;

	// hidden layer bias
	hlayer_b[0] = -1.446794;
	hlayer_b[1] = 1.583465;
	hlayer_b[2] = -0.690471;
	hlayer_b[3] = -0.469161;
	hlayer_b[4] = 0.500705;
	hlayer_b[5] = 0.611891;
	hlayer_b[6] = 1.572724;
	hlayer_b[7] = 0.042226;
	hlayer_b[8] = 0.002136;
	hlayer_b[9] = -0.196597;
	hlayer_b[10] = -1.367657;
	hlayer_b[11] = -1.695285;
	hlayer_b[12] = -1.177976;
	hlayer_b[13] = 1.642447;
	hlayer_b[14] = 0.174689;
	hlayer_b[15] = -0.496247;
	hlayer_b[16] = -0.239332;
	hlayer_b[17] = -0.836019;
	hlayer_b[18] = -4.088030;
	hlayer_b[19] = 1.118612;
	hlayer_b[20] = -1.110397;
	hlayer_b[21] = -1.428888;

	// output layer weights
	olayer_w[0] = 0.890745;
	olayer_w[1] = 1.493632;
	olayer_w[2] = 0.466687;
	olayer_w[3] = 0.497452;
	olayer_w[4] = 0.115083;
	olayer_w[5] = -0.715455;
	olayer_w[6] = 0.621880;
	olayer_w[7] = -0.524843;
	olayer_w[8] = -0.000348;
	olayer_w[9] = -0.439389;
	olayer_w[10] = 0.913920;
	olayer_w[11] = -0.175026;
	olayer_w[12] = -0.844973;
	olayer_w[13] = 0.723568;
	olayer_w[14] = -0.419851;
	olayer_w[15] = 0.130010;
	olayer_w[16] = 0.377320;
	olayer_w[17] = -0.747891;
	olayer_w[18] = 1.577075;
	olayer_w[19] = 0.430124;
	olayer_w[20] = 0.156079;
	olayer_w[21] = 0.889510;

	// output layer bias
	olayer_b[0] = -0.480033;

	end // end of initialization

	// preprocessing: scale inputs to [0,1] using training bounds, clamped
	// to the training range to avoid extrapolation blow-up outside it
	vg_s = (V(G,S) - vg_lo) / (vg_hi - vg_lo);
	if (vg_s < 0) vg_s = 0;
	if (vg_s > 1) vg_s = 1;

	vd_s = (V(D,S) - vd_lo) / (vd_hi - vd_lo);
	if (vd_s < 0) vd_s = 0;
	if (vd_s > 1) vd_s = 1;

	width_s = (w - w_lo) / (w_hi - w_lo);
	if (width_s < 0) width_s = 0;
	if (width_s > 1) width_s = 1;

	length_s = (l - l_lo) / (l_hi - l_lo);
	if (length_s < 0) length_s = 0;
	if (length_s > 1) length_s = 1;

	temp  = 0;   // accumulates d(raw_output)/d(vg_s) for gm
	temp1 = 0;   // accumulates d(raw_output)/d(vd_s) for gds

	for (i = 0; i < NNHL; i = i + 1) begin
		hlayer_v[i] = vg_s*hlayer_w[NI*i]   + vd_s*hlayer_w[NI*i+1]
		            + width_s*hlayer_w[NI*i+2] + length_s*hlayer_w[NI*i+3]
		            + hlayer_b[i];
		hlayer_y[i] = tanh(hlayer_v[i]);
		temp  = temp  + olayer_w[i]*hlayer_w[NI*i]   * (1 - hlayer_y[i]*hlayer_y[i]);
		temp1 = temp1 + olayer_w[i]*hlayer_w[NI*i+1] * (1 - hlayer_y[i]*hlayer_y[i]);
	end

	for (ii = 0; ii < NO; ii = ii + 1) begin
		olayer_v[ii] = 0;
		for (jj = 0; jj < NNHL; jj = jj + 1) begin
			olayer_v[ii] = olayer_v[ii] + hlayer_y[jj]*olayer_w[jj];
		end
		olayer_v[ii] = olayer_v[ii] + olayer_b[ii];   // linear output, no tanh
	end

	// post-processing: undo target standardization and the log10 transform
	log_id = olayer_v[0]*y_std + y_mean;
	id = pow(10.0, log_id);

	// small-signal parameters (chain rule through tanh hidden layer, the
	// linear output layer, the log10 back-transform, and the [0,1] input
	// scaling -- d(vg_s)/d(VG) = 1/(vg_hi-vg_lo), same for vd_s)
	gm  = id * `M_LN10 * y_std * temp  / (vg_hi - vg_lo);
	gds = id * `M_LN10 * y_std * temp1 / (vd_hi - vd_lo);

	I(D,S) <+ id;
	I(G,S) <+ 0;
	I(G,D) <+ 0;

	end

endmodule
