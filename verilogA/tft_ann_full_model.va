	if (cgd_dev_sel == 2) begin // W=160 L=15 um
		cgd_hlayer_w[0] = -1.184542; 	 cgd_hlayer_w[1] = 0.155277; 	 cgd_hlayer_w[2] = -2.419363; 	 cgd_hlayer_w[3] = -3.861677; 	 cgd_hlayer_w[4] = -11.151505; 	 cgd_hlayer_w[5] = -17.378357; 	 cgd_hlayer_w[6] = 0.283196; 	 cgd_hlayer_w[7] = 1.132208;
