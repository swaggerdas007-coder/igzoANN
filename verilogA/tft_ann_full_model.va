		cgd_hlayer_b[4] = -0.493511;
		cgd_hlayer_b[5] = 0.790620;
		cgd_hlayer_b[6] = -0.304953;
		cgd_hlayer_b[7] = 4.907038;
		cgd_olayer_w[0] = 2.191297;
		cgd_olayer_w[1] = -0.474588;
		cgd_olayer_w[2] = 0.538655;
		cgd_olayer_w[3] = -0.431974;
		cgd_olayer_w[4] = 0.519529;
		cgd_olayer_w[5] = -0.296524;
		cgd_olayer_w[6] = 0.009909;
		cgd_olayer_w[7] = 1.379055;
		cgd_olayer_b = 0.156863;
		cgd_c_mean = 5.041065e-13;
		cgd_c_std  = 3.255314e-13;
	end
	if (cgd_dev_sel == 1) begin // W=40 L=20 um
		cgd_hlayer_w[0] = -0.674732; 	 cgd_hlayer_w[1] = 0.041858; 	 cgd_hlayer_w[2] = 0.553123; 	 cgd_hlayer_w[3] = 0.660393; 	 cgd_hlayer_w[4] = 21.570562; 	 cgd_hlayer_w[5] = -1.679823; 	 cgd_hlayer_w[6] = -3.009449; 	 cgd_hlayer_w[7] = -8.617292;
