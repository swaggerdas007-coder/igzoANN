	if (cgd_dev_sel == 3) begin // W=160 L=20 um
		cgd_hlayer_w[0] = -17.128204; 	 cgd_hlayer_w[1] = -1.837484; 	 cgd_hlayer_w[2] = 0.840392; 	 cgd_hlayer_w[3] = -0.496152; 	 cgd_hlayer_w[4] = -12.087084; 	 cgd_hlayer_w[5] = 0.831842; 	 cgd_hlayer_w[6] = 0.007669; 	 cgd_hlayer_w[7] = 18.585323;
		cgd_hlayer_b[0] = 8.645453;
		cgd_hlayer_b[1] = 1.259560;
		cgd_hlayer_b[2] = 0.157989;
		cgd_hlayer_b[3] = -0.778064;
		cgd_hlayer_b[4] = 5.426540;
		cgd_hlayer_b[5] = -0.194759;
		cgd_hlayer_b[6] = 0.759690;
		cgd_hlayer_b[7] = -7.237505;
		cgd_olayer_w[0] = 1.442784;
		cgd_olayer_w[1] = -0.350603;
		cgd_olayer_w[2] = -0.091212;
		cgd_olayer_w[3] = -0.055844;
		cgd_olayer_w[4] = -3.959000;
