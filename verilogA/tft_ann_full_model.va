	hlayer_b[19] = 0.491972;
	hlayer_b[20] = 2.142080;
	hlayer_b[21] = -1.920079;
	hlayer_b[22] = 2.684408;
	hlayer_b[23] = 0.028959;
	hlayer_b[24] = -0.606180;
	hlayer_b[25] = -0.001280;
	hlayer_b[26] = 1.044605;
	hlayer_b[27] = -0.024463;
	hlayer_b[28] = -0.722012;
	hlayer_b[29] = -2.219025;
	hlayer_b[30] = 0.897722;
	hlayer_b[31] = 0.001694;

	// ID output layer weights
	olayer_w[0] = 0.191463;
	olayer_w[1] = 0.702611;
	olayer_w[2] = 1.043523;
	olayer_w[3] = -0.000015;
	olayer_w[4] = 0.970621;
	olayer_w[5] = -1.135900;
	olayer_w[6] = 0.000069;
	olayer_w[7] = 0.131407;
	olayer_w[8] = 1.545210;
	olayer_w[9] = -0.312631;
	olayer_w[10] = -0.000048;
	olayer_w[11] = -0.408185;
	olayer_w[12] = -0.190738;
	olayer_w[13] = 0.315844;
	olayer_w[14] = 0.518516;
	olayer_w[15] = -0.648074;
	olayer_w[16] = -0.000007;
	olayer_w[17] = 0.490034;
	olayer_w[18] = 0.483614;
	olayer_w[19] = -0.283802;
	olayer_w[20] = 1.634995;
	olayer_w[21] = 0.950316;
	olayer_w[22] = 1.240070;
