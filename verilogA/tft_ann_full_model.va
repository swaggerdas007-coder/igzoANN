	hlayer_w[124] = -0.001703; 	 hlayer_w[125] = -0.000549; 	 hlayer_w[126] = 0.000682; 	 hlayer_w[127] = -0.002664;

	// ID hidden layer bias
	hlayer_b[0] = 0.913660;
	hlayer_b[1] = -1.586235;
	hlayer_b[2] = 0.095963;
	hlayer_b[3] = 0.000112;
	hlayer_b[4] = -2.503599;
