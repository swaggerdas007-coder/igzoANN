		cgd_olayer_w[7] = -1.441658;
		cgd_olayer_b = 0.081748;
		cgd_c_mean = 3.694914e-12;
		cgd_c_std  = 2.535602e-12;
	end

	// nearest-match device selection for cgs (device parameters w, l are fixed per instance)
	cgs_best_dist = 1.0e30;
	cgs_dist = pow((w - 20.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 20.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgs_dist < cgs_best_dist) begin cgs_best_dist = cgs_dist; cgs_dev_sel = 0; end
	cgs_dist = pow((w - 40.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 20.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgs_dist < cgs_best_dist) begin cgs_best_dist = cgs_dist; cgs_dev_sel = 1; end
	cgs_dist = pow((w - 160.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 15.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgs_dist < cgs_best_dist) begin cgs_best_dist = cgs_dist; cgs_dev_sel = 2; end
	cgs_dist = pow((w - 160.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 20.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgs_dist < cgs_best_dist) begin cgs_best_dist = cgs_dist; cgs_dev_sel = 3; end
	if (cgs_dev_sel == 0) begin // W=20 L=20 um
		cgs_hlayer_w[0] = 2.279688; 	 cgs_hlayer_w[1] = -0.889313; 	 cgs_hlayer_w[2] = 1.115552; 	 cgs_hlayer_w[3] = -11.907557; 	 cgs_hlayer_w[4] = -16.879778; 	 cgs_hlayer_w[5] = -1.130590; 	 cgs_hlayer_w[6] = 2.043341; 	 cgs_hlayer_w[7] = -0.869322;
		cgs_hlayer_b[0] = -1.028029;
		cgs_hlayer_b[1] = 0.718677;
		cgs_hlayer_b[2] = 0.359450;
		cgs_hlayer_b[3] = 4.842114;
		cgs_hlayer_b[4] = 6.951757;
		cgs_hlayer_b[5] = -0.039628;
		cgs_hlayer_b[6] = -0.925680;
		cgs_hlayer_b[7] = -0.290109;
		cgs_olayer_w[0] = 0.730624;
		cgs_olayer_w[1] = 0.914272;
		cgs_olayer_w[2] = -0.129110;
		cgs_olayer_w[3] = 2.130286;
		cgs_olayer_w[4] = -2.865945;
		cgs_olayer_w[5] = 0.243519;
		cgs_olayer_w[6] = 0.293863;
		cgs_olayer_w[7] = -0.081126;
		cgs_olayer_b = -0.247864;
		cgs_c_mean = 5.009151e-13;
		cgs_c_std  = 3.371800e-13;
	end
	if (cgs_dev_sel == 1) begin // W=40 L=20 um
		cgs_hlayer_w[0] = -1.860953; 	 cgs_hlayer_w[1] = 0.705283; 	 cgs_hlayer_w[2] = -2.760894; 	 cgs_hlayer_w[3] = 17.322527; 	 cgs_hlayer_w[4] = -9.942814; 	 cgs_hlayer_w[5] = 0.107980; 	 cgs_hlayer_w[6] = 0.431006; 	 cgs_hlayer_w[7] = -0.211043;
		cgs_hlayer_b[0] = 1.695265;
		cgs_hlayer_b[1] = 0.339172;
		cgs_hlayer_b[2] = 1.312095;
		cgs_hlayer_b[3] = -7.110738;
		cgs_hlayer_b[4] = 4.029025;
		cgs_hlayer_b[5] = 0.165547;
		cgs_hlayer_b[6] = 0.072161;
		cgs_hlayer_b[7] = -1.046218;
		cgs_olayer_w[0] = 0.350378;
		cgs_olayer_w[1] = -0.069347;
		cgs_olayer_w[2] = -0.818862;
		cgs_olayer_w[3] = 2.323253;
		cgs_olayer_w[4] = 1.703456;
		cgs_olayer_w[5] = -0.036144;
		cgs_olayer_w[6] = -0.253176;
		cgs_olayer_w[7] = 0.106368;
		cgs_olayer_b = -0.111857;
		cgs_c_mean = 1.002550e-12;
		cgs_c_std  = 6.677234e-13;
	end
	if (cgs_dev_sel == 2) begin // W=160 L=15 um
		cgs_hlayer_w[0] = 17.147814; 	 cgs_hlayer_w[1] = 1.058321; 	 cgs_hlayer_w[2] = 3.774765; 	 cgs_hlayer_w[3] = -1.313953; 	 cgs_hlayer_w[4] = 4.045720; 	 cgs_hlayer_w[5] = -11.635500; 	 cgs_hlayer_w[6] = 0.181678; 	 cgs_hlayer_w[7] = -0.396709;
		cgs_hlayer_b[0] = -7.881513;
		cgs_hlayer_b[1] = 0.441258;
		cgs_hlayer_b[2] = -0.746673;
		cgs_hlayer_b[3] = 0.168713;
		cgs_hlayer_b[4] = -1.695564;
		cgs_hlayer_b[5] = 5.283528;
		cgs_hlayer_b[6] = -0.505646;
		cgs_hlayer_b[7] = -0.419578;
		cgs_olayer_w[0] = 2.925180;
		cgs_olayer_w[1] = -0.388304;
		cgs_olayer_w[2] = -0.220060;
		cgs_olayer_w[3] = -0.027328;
		cgs_olayer_w[4] = 0.877606;
		cgs_olayer_w[5] = 2.442400;
		cgs_olayer_w[6] = 0.059148;
		cgs_olayer_w[7] = 0.023442;
		cgs_olayer_b = 0.277112;
		cgs_c_mean = 2.717288e-12;
		cgs_c_std  = 1.992159e-12;
	end
	if (cgs_dev_sel == 3) begin // W=160 L=20 um
		cgs_hlayer_w[0] = 3.286913; 	 cgs_hlayer_w[1] = 20.687984; 	 cgs_hlayer_w[2] = 8.931392; 	 cgs_hlayer_w[3] = 3.539337; 	 cgs_hlayer_w[4] = 9.447197; 	 cgs_hlayer_w[5] = -1.158567; 	 cgs_hlayer_w[6] = 2.234795; 	 cgs_hlayer_w[7] = -15.561944;
		cgs_hlayer_b[0] = -0.997590;
		cgs_hlayer_b[1] = -8.104491;
		cgs_hlayer_b[2] = -2.705202;
		cgs_hlayer_b[3] = -1.086947;
		cgs_hlayer_b[4] = -4.205756;
		cgs_hlayer_b[5] = -0.423204;
		cgs_hlayer_b[6] = -0.535959;
		cgs_hlayer_b[7] = 8.254191;
		cgs_olayer_w[0] = 0.457201;
		cgs_olayer_w[1] = -1.479999;
		cgs_olayer_w[2] = -0.867922;
		cgs_olayer_w[3] = 0.981069;
		cgs_olayer_w[4] = 4.295738;
		cgs_olayer_w[5] = 0.069824;
		cgs_olayer_w[6] = -1.118264;
		cgs_olayer_w[7] = 1.359263;
		cgs_olayer_b = 0.098068;
		cgs_c_mean = 3.580102e-12;
		cgs_c_std  = 2.626697e-12;
	end

	end // end of initialization

	// ==== ID: preprocessing (min-max to [0,1], clamped to training range) ====
	vg_s = (V(G,S) - vg_lo) / (vg_hi - vg_lo);
	if (vg_s < 0) vg_s = 0;
	if (vg_s > 1) vg_s = 1;

	vd_s = (V(D,S) - vd_lo) / (vd_hi - vd_lo);
	if (vd_s < 0) vd_s = 0;
	if (vd_s > 1) vd_s = 1;

	width_s = (w - w_lo) / (w_hi - w_lo);
	if (width_s < 0) width_s = 0;
	if (width_s > 1) width_s = 1;

	length_s = (l - l_lo) / (l_hi - l_lo);
	if (length_s < 0) length_s = 0;
	if (length_s > 1) length_s = 1;

	temp  = 0;
	temp1 = 0;
	for (i = 0; i < NNHL; i = i + 1) begin
		hlayer_v[i] = vg_s*hlayer_w[NI*i]   + vd_s*hlayer_w[NI*i+1]
		            + width_s*hlayer_w[NI*i+2] + length_s*hlayer_w[NI*i+3]
		            + hlayer_b[i];
		hlayer_y[i] = tanh(hlayer_v[i]);
		temp  = temp  + olayer_w[i]*hlayer_w[NI*i]   * (1 - hlayer_y[i]*hlayer_y[i]);
		temp1 = temp1 + olayer_w[i]*hlayer_w[NI*i+1] * (1 - hlayer_y[i]*hlayer_y[i]);
	end

	olayer_v = 0;
	for (jj = 0; jj < NNHL; jj = jj + 1) begin
		olayer_v = olayer_v + hlayer_y[jj]*olayer_w[jj];
	end
	olayer_v = olayer_v + olayer_b;

	log_id = olayer_v*y_std + y_mean;
	id = pow(10.0, log_id);

	gm  = id * `M_LN10 * y_std * temp  / (vg_hi - vg_lo);
	gds = id * `M_LN10 * y_std * temp1 / (vd_hi - vd_lo);

	I(D,S) <+ id;

	// ==== CGD: MLP forward pass on VG -> capacitance [F] (device-selected weights) ====
	vgc_s = (V(G,S) - cap_vg_lo) / (cap_vg_hi - cap_vg_lo);
	if (vgc_s < 0) vgc_s = 0;
	if (vgc_s > 1) vgc_s = 1;
	cgd_out = 0;
	for (i = 0; i < CAP_NNHL; i = i + 1) begin
		cgd_hlayer_y[i] = tanh(vgc_s*cgd_hlayer_w[i] + cgd_hlayer_b[i]);
		cgd_out = cgd_out + cgd_hlayer_y[i]*cgd_olayer_w[i];
	end
	cgd_out = cgd_out + cgd_olayer_b;
	cgd = cgd_out*cgd_c_std + cgd_c_mean;
	if (cgd < 0) cgd = 0;   // capacitance floor: reject small extrapolation excursions below 0

	// ==== CGS: MLP forward pass on VG -> capacitance [F] (device-selected weights) ====
	cgs_out = 0;
	for (i = 0; i < CAP_NNHL; i = i + 1) begin
		cgs_hlayer_y[i] = tanh(vgc_s*cgs_hlayer_w[i] + cgs_hlayer_b[i]);
		cgs_out = cgs_out + cgs_hlayer_y[i]*cgs_olayer_w[i];
	end
	cgs_out = cgs_out + cgs_olayer_b;
	cgs = cgs_out*cgs_c_std + cgs_c_mean;
	if (cgs < 0) cgs = 0;   // capacitance floor: reject small extrapolation excursions below 0

	// Charge-based capacitive branch currents (well-posed for the simulator's
	// charge-conservation checks, unlike a raw I <+ C*ddt(V) linear-cap form)
	qgd = cgd * V(G,D);
	qgs = cgs * V(G,S);
	I(G,D) <+ ddt(qgd);
	I(G,S) <+ ddt(qgs);

	end

endmodule
