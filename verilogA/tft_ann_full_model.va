	olayer_w[30] = -0.180898;
	olayer_w[31] = -0.000015;

	// ID output layer bias
	olayer_b = 0.000051;

	// nearest-match device selection for cgd (device parameters w, l are fixed per instance)
	cgd_best_dist = 1.0e30;
	cgd_dist = pow((w - 20.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 20.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgd_dist < cgd_best_dist) begin cgd_best_dist = cgd_dist; cgd_dev_sel = 0; end
	cgd_dist = pow((w - 40.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 20.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgd_dist < cgd_best_dist) begin cgd_best_dist = cgd_dist; cgd_dev_sel = 1; end
	cgd_dist = pow((w - 160.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 15.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgd_dist < cgd_best_dist) begin cgd_best_dist = cgd_dist; cgd_dev_sel = 2; end
	cgd_dist = pow((w - 160.0e-6)/(160.0e-6-20.0e-6), 2) + pow((l - 20.0e-6)/(20.0e-6-15.0e-6), 2);
	if (cgd_dist < cgd_best_dist) begin cgd_best_dist = cgd_dist; cgd_dev_sel = 3; end
	if (cgd_dev_sel == 0) begin // W=20 L=20 um
