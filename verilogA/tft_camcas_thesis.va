// IGZO TFT compact DC model -- CAMCAS, Appendix F of C. de Almeida,
// "Development of IGZO thin-film transistors (TFTs) compact models" (2025),
// re-parameterized on this repository's measurements.
//
// Structure and equations follow Listing F.1 line for line. Every model
// parameter is a function of the instance geometry (W, L in um):
//   Von, alpha, kappa, G0, Ioff (lin & sat):
//       X(L,W) = (aW*W + a0)*L^2 + (bW*W + b0)*L + (cW*W + c0)   (Eqs. 3.5-3.16)
//   DeltaL(W), RSD(W): straight lines in W                      (Eqs. 3.17-3.18)
//   m: one global constant.
// Coefficients: parameters extracted per device with the thesis's
// automatic procedure (Sec. 3.2), scaled with the thesis two-step fit
// (quadratic in L per width, then linear in W),
// then Von/alpha/kappa/G0 coefficients refined against the fit devices'
// measured currents (scripts/camcas_thesis/refine.py).
// Fit geometries (W/L um): 20/5, 20/10, 20/15, 20/20, 40/5, 40/10, 40/15, 40/20, 80/5, 80/10, 80/15, 80/20, 160/5, 160/10, 160/15, 160/20.
// Held out, never used for fitting: 5/5, 10/5, 10/10. Coefficient variant:
// "thesis_g". Valid range: W = 20..160 um, L = 5..20 um, 0 <= VDS.
//
// Differences from Listing F.1 (both on the RSD line, see
// scripts/camcas_thesis/step4_export_va.py): RSD_func is in kOhm and is
// converted with *1e3 (F.1 divides by 100), and it is clamped at 0.
// The charge block is copied verbatim from F.1 and was not re-extracted.
//
// Auto-generated by scripts/camcas_thesis/step4_export_va.py -- regenerate,
// don't hand-edit.

`include "constants.vams"
`include "disciplines.vams"

module tft_camcas_thesis(d, g, s);

inout d, g, s;
electrical d, g, s;

parameter real W = 40; // um
parameter real L = 10; // um

parameter real VH = 5;
parameter real VDSref_lin = 0.1;
parameter real VDSref_sat = 5;

parameter real eps_ox = 3.45e-11;
parameter real tox = 0.1e-6;

parameter real m = 2.03327;

real Vgs, Vds, Vgd, Von_lin, Von_sat, Von_eff;
real alpha_lin, alpha_sat;
real G0_lin, G0_sat;
real Ioff_lin, Ioff_sat;
real DeltaL, RSD;
real k_lin, k_sat;
real Lp;
real Ids_sat, Ids_lin;
real Ids_total;
real term_exp;
real G;
real Covs, Covd, CCH;
real Qovs, Qovd, Qch;
real Lov, Lovch;

analog function real von_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		von_lin_func = ((-1.7315399766e-06 * Wm + -3.0933951200e-05) * L2) +
		         ((3.2339907943e-04 * Wm + -5.8257074556e-03) * Lm) +
		         (-3.5447229914e-03 * Wm + -4.0497308271e-01);
	end
endfunction

analog function real von_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		von_sat_func = ((-2.7489094376e-05 * Wm + 5.6035205845e-04) * L2) +
		         ((5.9481147126e-04 * Wm + 1.1793577869e-02) * Lm) +
		         (-2.9638187646e-03 * Wm + -6.5467991416e-01);
	end
endfunction

analog function real alpha_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		alpha_lin_func = ((-1.9954045446e-05 * Wm + 1.4752010538e-03) * L2) +
		         ((4.3278985114e-04 * Wm + -2.4838450693e-02) * Lm) +
		         (-2.2614193833e-03 * Wm + -3.5293463977e-01);
	end
endfunction

analog function real alpha_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		alpha_sat_func = ((-1.5164929200e-05 * Wm + 1.4307630319e-03) * L2) +
		         ((4.0218055429e-04 * Wm + -4.0194976455e-02) * Lm) +
		         (-2.6839231538e-03 * Wm + -2.0967799994e-01);
	end
endfunction

analog function real kappa_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		kappa_lin_func = ((6.3604298378e-05 * Wm + -6.5276618038e-03) * L2) +
		         ((-8.0145628824e-04 * Wm + 1.2852153437e-01) * Lm) +
		         (5.0153065838e-03 * Wm + -6.9208355042e+00);
	end
endfunction

analog function real kappa_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		kappa_sat_func = ((-8.9729573332e-05 * Wm + 3.2412180039e-03) * L2) +
		         ((2.3610948116e-03 * Wm + 4.5941860828e-03) * Lm) +
		         (-1.2299699999e-02 * Wm + -6.8219446477e+00);
	end
endfunction

analog function real G0_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		G0_lin_func = ((-1.5707518249e-08 * Wm + 1.8337065377e-06) * L2) +
		         ((3.0233071774e-07 * Wm + -3.4079100220e-05) * Lm) +
		         (-1.5280014831e-06 * Wm + 2.5482679448e-04);
	end
endfunction

analog function real G0_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		G0_sat_func = ((-2.8529259183e-09 * Wm + 4.3129397264e-07) * L2) +
		         ((7.8041211696e-08 * Wm + -1.3734337076e-05) * Lm) +
		         (-5.5405892499e-07 * Wm + 1.3989160390e-04);
	end
endfunction

analog function real Ioff_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		Ioff_lin_func = ((-6.5934086957e-17 * Wm + -6.5582434783e-15) * L2) +
		         ((1.4718725217e-15 * Wm + 1.8640266087e-13) * Lm) +
		         (-5.5694217391e-15 * Wm + 2.2513091304e-12);
	end
endfunction

analog function real Ioff_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		Ioff_sat_func = ((-1.1188382609e-16 * Wm + 1.5290086957e-14) * L2) +
		         ((3.1072459130e-15 * Wm + -4.7521384348e-13) * Lm) +
		         (-2.0034791304e-14 * Wm + 6.5058843478e-12);
	end
endfunction

analog function real DeltaL_func;
	input Wm;
	real Wm;
	begin
		DeltaL_func = -4.3974686957e-03 * Wm + -2.3992034783e-01; // [um]
	end
endfunction

analog function real RSD_func;
	input Wm;
	real Wm;
	begin
		RSD_func = -2.6395073913e-02 * Wm + 3.3593730435e+00; // [kOhm]
	end
endfunction

analog begin

	Vgs = V(g, s);
	Vds = V(d, s);
	Vgd = V(g, d);

	DeltaL = DeltaL_func(W);
	RSD = RSD_func(W) * 1e3; // kOhm -> Ohm
	if (RSD < 0) RSD = 0;

	Von_lin = von_lin_func(L, W);
	Von_sat = von_sat_func(L, W);
	alpha_lin = alpha_lin_func(L, W);
	alpha_sat = alpha_sat_func(L, W);
	k_lin = kappa_lin_func(L, W);
	k_sat = kappa_sat_func(L, W);
	G0_lin = G0_lin_func(L, W);
	G0_sat = G0_sat_func(L, W);
	Ioff_lin = Ioff_lin_func(L, W);
	Ioff_sat = Ioff_sat_func(L, W);

	Lp = L - DeltaL;

	Lov = L*10e-5;
	Lovch = 0.8*L*1e-6;

	Covs = eps_ox * W * 1e-5 * Lov / tox;
	Covd = eps_ox * W * 1e-5 * Lov / tox;
	CCH = eps_ox * W * 1e-5 * Lovch / tox;

	Qovs = Covs * V(g,s);
	Qovd = Covd * V(g,d);
	Qch = CCH * V(g,s);

	if (Von_lin < Von_sat)
		Von_eff = Von_sat;
	else
		Von_eff = Von_lin;

	if (Vgs <= Von_eff) begin
		if (Vds < (Vgs - Von_eff)) begin
			Ids_total = Ioff_lin;
		end
		else begin
			Ids_total = Ioff_sat;
		end
	end
	else begin
		term_exp = exp(k_lin * (Vgs - Von_eff)**alpha_lin);
		G = G0_lin * (W / Lp) * term_exp;
		Ids_lin = (G * Vds + Ioff_lin) / (1 + RSD * G);

		Ids_sat = G0_sat * (W/Lp) * exp(k_sat * (Vgs - Von_eff)**alpha_sat) * (Vgs - Von_eff) + Ioff_sat;

		Ids_total = (Ids_lin**(-m) + Ids_sat**(-m))**(-1/m);
	end

	I(d,s) <+ Ids_total;
	I(g,s) <+ ddt(Qovs + Qch);
	I(g,d) <+ ddt(Qovd);
end

endmodule
