// IGZO TFT compact DC model -- CAMCAS, Appendix F of C. de Almeida,
// "Development of IGZO thin-film transistors (TFTs) compact models" (2025),
// re-parameterized on this repository's measurements.
//
// Structure and equations follow Listing F.1 line for line. Every model
// parameter is a function of the instance geometry (W, L in um):
//   Von, alpha, kappa, G0, Ioff (lin & sat):
//       X(L,W) = (aW*W + a0)*L^2 + (bW*W + b0)*L + (cW*W + c0)   (Eqs. 3.5-3.16)
//   DeltaL(W), RSD(W): straight lines in W                      (Eqs. 3.17-3.18)
//   m: one global constant.
// Coefficients: parameters extracted per device with the thesis's
// automatic procedure (Sec. 3.2), scaled with the thesis two-step fit
// (quadratic in L per width, then linear in W),
// then Von/alpha/kappa/G0 coefficients refined against the fit devices'
// measured currents (scripts/camcas_thesis/refine.py).
// Fit geometries (W/L um): 20/5, 20/10, 20/15, 20/20, 40/5, 40/10, 40/15, 40/20, 80/5, 80/10, 80/15, 80/20, 160/5, 160/10, 160/15.
// Held out, never used for fitting: 5/5, 10/5, 10/10. Coefficient variant:
// "thesis_x_g". Valid range: W = 20..160 um, L = 5..20 um, 0 <= VDS.
//
// Differences from Listing F.1 (both on the RSD line, see
// scripts/camcas_thesis/step4_export_va.py): RSD_func is in kOhm and is
// converted with *1e3 (F.1 divides by 100), and it is clamped at 0.
// The charge block is copied verbatim from F.1 and was not re-extracted.
//
// Auto-generated by scripts/camcas_thesis/step4_export_va.py -- regenerate,
// don't hand-edit.

`include "constants.vams"
`include "disciplines.vams"

module tft_camcas_thesis(d, g, s);

inout d, g, s;
electrical d, g, s;

parameter real W = 40; // um
parameter real L = 10; // um

parameter real VH = 5;
parameter real VDSref_lin = 0.1;
parameter real VDSref_sat = 5;

parameter real eps_ox = 3.45e-11;
parameter real tox = 0.1e-6;

parameter real m = 2.03308;

real Vgs, Vds, Vgd, Von_lin, Von_sat, Von_eff;
real alpha_lin, alpha_sat;
real G0_lin, G0_sat;
real Ioff_lin, Ioff_sat;
real DeltaL, RSD;
real k_lin, k_sat;
real Lp;
real Ids_sat, Ids_lin;
real Ids_total;
real term_exp;
real G;
real Covs, Covd, CCH;
real Qovs, Qovd, Qch;
real Lov, Lovch;

analog function real von_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		von_lin_func = ((-6.7369610043e-05 * Wm + 4.1864556337e-03) * L2) +
		         ((1.6227777419e-03 * Wm + -8.9262301422e-02) * Lm) +
		         (-8.5886291150e-03 * Wm + -6.5094822177e-02);
	end
endfunction

analog function real von_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		von_sat_func = ((-4.9000995620e-05 * Wm + 7.7487010016e-04) * L2) +
		         ((9.4423521160e-04 * Wm + 9.0251752347e-03) * Lm) +
		         (-4.3011493269e-03 * Wm + -6.2749167162e-01);
	end
endfunction

analog function real alpha_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		alpha_lin_func = ((-1.8504066016e-05 * Wm + 1.0320778753e-03) * L2) +
		         ((4.7523440683e-04 * Wm + -1.7287948455e-02) * Lm) +
		         (-2.5520579328e-03 * Wm + -3.6801150744e-01);
	end
endfunction

analog function real alpha_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		alpha_sat_func = ((-2.6332130960e-05 * Wm + 1.6136371863e-03) * L2) +
		         ((5.9342732131e-04 * Wm + -4.4706093233e-02) * Lm) +
		         (-3.3703116394e-03 * Wm + -1.7175621108e-01);
	end
endfunction

analog function real kappa_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		kappa_lin_func = ((1.5250785380e-04 * Wm + -1.3277773824e-02) * L2) +
		         ((-3.4298026387e-03 * Wm + 3.0452827565e-01) * Lm) +
		         (1.7713070968e-02 * Wm + -7.8347828615e+00);
	end
endfunction

analog function real kappa_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		kappa_sat_func = ((-9.7834763257e-05 * Wm + 2.9999842263e-03) * L2) +
		         ((2.8388528897e-03 * Wm + 7.8336827185e-03) * Lm) +
		         (-1.5532296616e-02 * Wm + -6.8837089149e+00);
	end
endfunction

analog function real G0_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		G0_lin_func = ((-4.3425464542e-08 * Wm + 3.7040079685e-06) * L2) +
		         ((9.9591557365e-07 * Wm + -7.9119321247e-05) * Lm) +
		         (-4.6966087462e-06 * Wm + 4.8504639622e-04);
	end
endfunction

analog function real G0_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		G0_sat_func = ((-2.3811862451e-09 * Wm + 4.4471508631e-07) * L2) +
		         ((6.2785362089e-08 * Wm + -1.5099591974e-05) * Lm) +
		         (-4.8759047619e-07 * Wm + 1.5914680536e-04);
	end
endfunction

analog function real Ioff_lin_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		Ioff_lin_func = ((-1.3511627525e-17 * Wm + -8.7168153372e-15) * L2) +
		         ((4.7584579254e-16 * Wm + 2.2741552619e-13) * Lm) +
		         (-1.6377372818e-15 * Wm + 2.0894162410e-12);
	end
endfunction

analog function real Ioff_sat_func;
	input Lm, Wm;
	real Lm, Wm;
	real L2;
	begin
		L2 = Lm*Lm;
		Ioff_sat_func = ((-7.9214509186e-17 * Wm + 1.3944879790e-14) * L2) +
		         ((2.4865288919e-15 * Wm + -4.4965490731e-13) * Lm) +
		         (-1.7584592537e-14 * Wm + 6.4049938103e-12);
	end
endfunction

analog function real DeltaL_func;
	input Wm;
	real Wm;
	begin
		DeltaL_func = -4.3974686957e-03 * Wm + -2.3992034783e-01; // [um]
	end
endfunction

analog function real RSD_func;
	input Wm;
	real Wm;
	begin
		RSD_func = -2.6395073913e-02 * Wm + 3.3593730435e+00; // [kOhm]
	end
endfunction

analog begin

	Vgs = V(g, s);
	Vds = V(d, s);
	Vgd = V(g, d);

	DeltaL = DeltaL_func(W);
	RSD = RSD_func(W) * 1e3; // kOhm -> Ohm
	if (RSD < 0) RSD = 0;

	Von_lin = von_lin_func(L, W);
	Von_sat = von_sat_func(L, W);
	alpha_lin = alpha_lin_func(L, W);
	alpha_sat = alpha_sat_func(L, W);
	k_lin = kappa_lin_func(L, W);
	k_sat = kappa_sat_func(L, W);
	G0_lin = G0_lin_func(L, W);
	G0_sat = G0_sat_func(L, W);
	Ioff_lin = Ioff_lin_func(L, W);
	Ioff_sat = Ioff_sat_func(L, W);

	Lp = L - DeltaL;

	Lov = L*10e-5;
	Lovch = 0.8*L*1e-6;

	Covs = eps_ox * W * 1e-5 * Lov / tox;
	Covd = eps_ox * W * 1e-5 * Lov / tox;
	CCH = eps_ox * W * 1e-5 * Lovch / tox;

	Qovs = Covs * V(g,s);
	Qovd = Covd * V(g,d);
	Qch = CCH * V(g,s);

	if (Von_lin < Von_sat)
		Von_eff = Von_sat;
	else
		Von_eff = Von_lin;

	if (Vgs <= Von_eff) begin
		if (Vds < (Vgs - Von_eff)) begin
			Ids_total = Ioff_lin;
		end
		else begin
			Ids_total = Ioff_sat;
		end
	end
	else begin
		term_exp = exp(k_lin * (Vgs - Von_eff)**alpha_lin);
		G = G0_lin * (W / Lp) * term_exp;
		Ids_lin = (G * Vds + Ioff_lin) / (1 + RSD * G);

		Ids_sat = G0_sat * (W/Lp) * exp(k_sat * (Vgs - Von_eff)**alpha_sat) * (Vgs - Von_eff) + Ioff_sat;

		Ids_total = (Ids_lin**(-m) + Ids_sat**(-m))**(-1/m);
	end

	I(d,s) <+ Ids_total;
	I(g,s) <+ ddt(Qovs + Qch);
	I(g,d) <+ ddt(Qovd);
end

endmodule
